# AgencyOS - gemeinsame Polymath-Produktionsumgebung

# Server Port & Basis-URL
PORT=3000
BASE_URL=
AGENCY_OS_ALLOWED_ORIGINS=https://agencyos.com,https://www.agencyos.com

# Firebase (gemeinsames Projekt; Web-Key ist öffentlich, Admin-Key niemals)
FIREBASE_PROJECT_ID=polymath-productions
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=polymath-productions.firebaseapp.com
FIREBASE_STORAGE_BUCKET=polymath-productions.firebasestorage.app
FIREBASE_MESSAGING_SENDER_ID=11186161755
FIREBASE_WEB_APP_ID=
FIREBASE_MEASUREMENT_ID=G-0ML0NWH05Z
FIREBASE_SERVICE_ACCOUNT_PATH=/run/secrets/firebase-admin-key.json

# Stripe-Konfiguration (AgencyOS-Price-IDs separat von Polymath bestätigen)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
AGENCY_OS_STRIPE_PRODUCT_ID=
AGENCY_OS_PRICE_EUR_MONTHLY=
AGENCY_OS_PRICE_USD_MONTHLY=
AGENCY_OS_PRICE_IDR_MONTHLY=
AGENCY_OS_PRICE_SGD_MONTHLY=
AGENCY_OS_PRICE_AUD_MONTHLY=

# Optionale serverseitige KI-/E-Mail-Konfiguration
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
BREVO_API_KEY=
EMAIL_PROVIDER=n8n
EMAIL_SENDER=noreply@reglerproductions.com
EMAIL_SENDER_NAME=AgencyOS by Regler Productions
N8N_WEBHOOK_URL=https://n8n.reglerproductions.com/webhook/polymath-mail
N8N_WEBHOOK_TOKEN=

# Admin-Credentials nur als read-only Datei auf dem Server mounten.
# Niemals FIREBASE_SERVICE_ACCOUNT oder private Schlüssel committen.
